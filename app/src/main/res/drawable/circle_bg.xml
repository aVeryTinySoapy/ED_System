<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Fill color -->
    <solid android:color="#1A237E" /> <!-- Change to your desired color -->

    <!-- Optional border -->
    <stroke
        android:width="2dp"
        android:color="#1A237E" /> <!-- Change stroke color -->

    <!-- Optional padding inside the circle -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
