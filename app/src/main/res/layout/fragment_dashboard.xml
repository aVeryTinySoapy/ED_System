<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EnviroFlow Detect"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Water Quality Monitoring"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <!-- CURRENT PARAMETERS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Parameters"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/deviceSiteLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lake Site 1 • LAKE"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <!-- PARAMETER CARDS-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <include
                android:id="@+id/tempCard"
                layout="@layout/item_parameter_card"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight=".90" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.15" />

            <include
                android:id="@+id/phCard"
                layout="@layout/item_parameter_card"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight=".90" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="0.15" />

            <include
                android:id="@+id/doCard"
                layout="@layout/item_parameter_card"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_weight=".90" />

        </LinearLayout>


        <!-- ACTIVE ALERTS -->
        <TextView
            android:id="@+id/activeAlertsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Alerts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/alertsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/noAlertsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Active Alerts"
                android:textAlignment="center"
                android:padding="16dp"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>



        <!-- DEVICE STATUS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/deviceRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="20dp" />


    </LinearLayout>
</ScrollView>
